<Window x:Class="FazTudo.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conserta SIA · CPD" Height="860" Width="1380" MinHeight="640" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        BorderThickness="1" BorderBrush="#C9D1DD">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Menu lateral ================= -->
        <Border Background="{StaticResource SidebarBrush}">
            <DockPanel LastChildFill="True">
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,26,0,28">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource LogoBrush}">
                        <TextBlock Text="&#xE95E;" Style="{StaticResource Icon}" Foreground="White" FontSize="18" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Conserta SIA" Foreground="White" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="CPD · faturamento SIA/SUS" Foreground="{StaticResource SidebarMutedBrush}" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>

                <!-- Rodapé: status da tabela SIGTAP -->
                <Border DockPanel.Dock="Bottom" Margin="16,0,16,18" CornerRadius="10" Background="#152036" Padding="14,12"
                        Cursor="Hand" MouseLeftButtonUp="SigtapStatus_Click" ToolTip="Abrir o Consultor SIGTAP">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="SigtapDot" Width="8" Height="8" Fill="#F59E0B" VerticalAlignment="Top" Margin="0,5,10,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="TABELA SIGTAP" Foreground="{StaticResource SidebarMutedBrush}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="SigtapStatusText" Foreground="#E2E8F0" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel>
                    <TextBlock Text="FERRAMENTAS" Foreground="{StaticResource SidebarMutedBrush}" FontSize="10.5" FontWeight="Bold" Margin="26,0,0,8"/>
                    <RadioButton x:Name="NavSolver" Style="{StaticResource NavButton}" Tag="&#xEA80;" Content="Solucionador SIA" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavKnowledge" Style="{StaticResource NavButton}" Tag="&#xE82D;" Content="Base de Erros" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSigtap" Style="{StaticResource NavButton}" Tag="&#xE8F1;" Content="Consultor SIGTAP" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavTriador" Style="{StaticResource NavButton}" Tag="&#xE9F9;" Content="Triador BPA" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavDoctor" Style="{StaticResource NavButton}" Tag="&#xE90F;" Content="Doutor TI DATASUS" Checked="Nav_Checked"/>
                    <TextBlock Text="PLATAFORMA" Foreground="{StaticResource SidebarMutedBrush}" FontSize="10.5" FontWeight="Bold" Margin="26,22,0,8"/>
                    <RadioButton x:Name="NavModules" Style="{StaticResource NavButton}" Tag="&#xE71D;" Content="Módulos" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Conteúdo ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra de título (arrastável pelo WindowChrome) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimizar"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="Maximize_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximizar"/>
                <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" Click="Close_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Fechar"/>
            </StackPanel>

            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="36,0,36,28" Focusable="False"/>
        </Grid>
    </Grid>
</Window>
