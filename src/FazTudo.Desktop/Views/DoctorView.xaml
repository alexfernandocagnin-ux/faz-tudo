<UserControl x:Class="FazTudo.Desktop.Views.DoctorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,4,0,20">
            <Button x:Name="RunButton" DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource PrimaryButton}" Click="RunButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="14"/>
                    <TextBlock x:Name="RunButtonText" Text="Executar diagnóstico" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Doutor TI DATASUS" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Lead}" Margin="0,6,0,0"
                           Text="Verifica se este computador está pronto para rodar SIA, BPA-Mag, APAC-Mag e SCNES. Só lê, não altera nada."/>
            </StackPanel>
        </DockPanel>

        <!-- Resumo -->
        <UniformGrid x:Name="Summary" Grid.Row="1" Rows="1" Margin="-8,0,-8,18" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Margin="8,0" Padding="18,14">
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource SuccessSoftBrush}">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CountOk" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="tudo certo" Style="{StaticResource Caption}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0" Padding="18,14">
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource WarningSoftBrush}">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CountAttention" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="pedem atenção" Style="{StaticResource Caption}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0" Padding="18,14">
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource DangerSoftBrush}">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CountCritical" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="problemas críticos" Style="{StaticResource Caption}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0" Padding="18,14">
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource HoverBrush}">
                        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CountInfo" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="informativos" Style="{StaticResource Caption}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Estado inicial -->
        <Border x:Name="EmptyState" Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                <Border Width="72" Height="72" CornerRadius="20" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" FontSize="30" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="Pronto para examinar esta máquina" Style="{StaticResource H2}" TextAlignment="Center" Margin="0,22,0,8"/>
                <TextBlock Style="{StaticResource Lead}" TextAlignment="Center"
                           Text="Pastas de instalação, VirtualStore do Windows, Firebird na porta 3050, midas.dll, BDE e espaço em disco. Leva poucos segundos."/>
            </StackPanel>
        </Border>

        <!-- Resultados -->
        <ScrollViewer x:Name="ResultsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <ItemsControl x:Name="ResultsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,4,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top"
                                        Background="{Binding Status, Converter={StaticResource StatusBackground}}">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusGlyph}}" Style="{StaticResource Icon}" FontSize="15"
                                               HorizontalAlignment="Center" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,16,0">
                                    <TextBlock Text="{Binding Category}" Style="{StaticResource Overline}"/>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" FontSize="15" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding DetectedState}" Style="{StaticResource Body}" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding Recommendation}" Style="{StaticResource Body}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    <Button Content="Ver solução na Base de Erros →" Style="{StaticResource LinkButton}" Margin="0,10,0,0" HorizontalAlignment="Left"
                                            Tag="{Binding LinkedKnowledgeErrorId}" Click="KnowledgeLink_Click"
                                            Visibility="{Binding LinkedKnowledgeErrorId, Converter={StaticResource NullToCollapsed}}"/>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Top"
                                        Background="{Binding Status, Converter={StaticResource StatusBackground}}">
                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
