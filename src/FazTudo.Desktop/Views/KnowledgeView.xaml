<UserControl x:Class="FazTudo.Desktop.Views.KnowledgeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,4,0,20">
            <TextBlock Text="Base de Erros" Style="{StaticResource H1}"/>
            <TextBlock x:Name="LeadText" Style="{StaticResource Lead}" Margin="0,6,0,0"/>
        </StackPanel>

        <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource SearchBox}"
                 Tag="Buscar por código, sintoma ou sistema — ex.: 004, cbo, firebird, sem orçamento"
                 TextChanged="SearchBox_TextChanged"/>

        <WrapPanel x:Name="LayerChips" Grid.Row="2" Margin="0,14,0,8"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Lista -->
            <Border Style="{StaticResource Card}" Padding="0,8">
                <Grid>
                    <ListBox x:Name="EntryList" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource CleanListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="EntryList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,11,14,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" VerticalAlignment="Top"
                                            Background="{Binding Severity, Converter={StaticResource StatusBackground}}">
                                        <TextBlock Text="{Binding Severity, Converter={StaticResource StatusGlyph}}" Style="{StaticResource Icon}"
                                                   FontSize="13" HorizontalAlignment="Center"
                                                   Foreground="{Binding Severity, Converter={StaticResource StatusBrush}}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ErrorCode}" Style="{StaticResource Mono}" FontWeight="Bold" FontSize="12"
                                                       Foreground="{Binding Severity, Converter={StaticResource StatusBrush}}"/>
                                            <TextBlock Text="•" Foreground="{StaticResource TextMutedBrush}" Margin="6,0" FontSize="11"/>
                                            <TextBlock Text="{Binding Layer}" Style="{StaticResource Caption}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,3,0,0" LineHeight="18"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="NoResults" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="28" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Nada encontrado" Style="{StaticResource H3}" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                        <TextBlock Text="Tente outro termo ou limpe o filtro." Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Detalhe -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Detail" DataContext="{Binding SelectedItem, ElementName=EntryList}" Margin="30,26,30,30">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource Pill}" Background="{Binding Severity, Converter={StaticResource StatusBackground}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Severity, Converter={StaticResource StatusGlyph}}" Style="{StaticResource Icon}" FontSize="11"
                                               Foreground="{Binding Severity, Converter={StaticResource StatusBrush}}"/>
                                    <TextBlock Text="{Binding SeverityDisplay}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"
                                               Foreground="{Binding Severity, Converter={StaticResource StatusBrush}}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="{StaticResource HoverBrush}" Margin="8,0,0,0">
                                <TextBlock Text="{Binding ErrorCode}" Style="{StaticResource Mono}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <TextBlock Text="{Binding Layer}" Style="{StaticResource Caption}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="23" Margin="0,16,0,0"/>

                        <ItemsControl ItemsSource="{Binding AffectedSystems, Converter={StaticResource SplitList}}" Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" Padding="8,3" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="16,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7B3;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="O QUE APARECE" Style="{StaticResource Overline}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Symptom}" Style="{StaticResource Body}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="16,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEA80;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="POR QUE ACONTECE" Style="{StaticResource Overline}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding RootCause}" Style="{StaticResource Body}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="16,12" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8C7;" Style="{StaticResource Icon}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="IMPACTO FINANCEIRO" Style="{StaticResource Overline}" Foreground="{StaticResource DangerBrush}"/>
                                    <TextBlock Text="{Binding FinancialImpactNote}" Style="{StaticResource Body}" Foreground="#7F1D1D" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Como resolver" Style="{StaticResource H3}" FontSize="16" Margin="0,28,0,14"/>
                        <ItemsControl x:Name="StepsList" ItemsSource="{Binding GuidedSteps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- linha do tempo -->
                                        <Border Width="2" Background="{StaticResource LineBrush}" HorizontalAlignment="Center" Margin="0,30,14,0"/>
                                        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource AccentBrush}"
                                                VerticalAlignment="Top" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StepNumber}" Foreground="White" FontWeight="Bold" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="0,4,0,24">
                                            <TextBlock Text="{Binding ActionTitle}" Style="{StaticResource H3}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding TargetSystem}" Style="{StaticResource Caption}" Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DetailedInstruction}" Style="{StaticResource Body}" Margin="0,8,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="12,8" Margin="0,10,0,0"
                                                    Visibility="{Binding VerificationTip, Converter={StaticResource NullToCollapsed}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                                               VerticalAlignment="Top" Margin="0,3,10,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding VerificationTip}" Style="{StaticResource Body}" Foreground="#115E59"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
