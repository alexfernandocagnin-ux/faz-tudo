<UserControl x:Class="FazTudo.Desktop.Views.ModulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,4,4,0">
            <TextBlock Text="Módulos" Style="{StaticResource H1}"/>
            <TextBlock x:Name="LeadText" Style="{StaticResource Lead}" Margin="0,6,0,20"/>

            <ItemsControl x:Name="ErrorsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE783;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource DangerBrush}"/>
                                <TextBlock Text="{Binding}" Style="{StaticResource Body}" Foreground="#7F1D1D" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl x:Name="ModulesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource LogoBrush}">
                                        <TextBlock Text="{Binding BadgeText}" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H2}"/>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Border Style="{StaticResource Pill}" Background="{StaticResource AccentSoftBrush}">
                                            <TextBlock Text="{Binding Stage}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}"/>
                                        </Border>
                                        <Border Style="{StaticResource Pill}" Background="{StaticResource HoverBrush}" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding Version, StringFormat=v{0}}" Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,0"/>
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="16,14">
                                        <StackPanel>
                                            <TextBlock Text="O QUE FAZ" Style="{StaticResource Overline}" Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{Binding Capabilities}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="22"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Body}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="16,14">
                                        <StackPanel>
                                            <TextBlock Text="PRÓXIMOS PASSOS" Style="{StaticResource Overline}" Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{Binding PlannedRoadmapItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="22"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Body}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Plugins -->
            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xEA86;" Style="{StaticResource Icon}" FontSize="20" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,2,14,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Adicionar módulos" Style="{StaticResource H3}"/>
                        <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"
                                   Text="Coloque a DLL de um módulo (SIHD/AIH, SCNES, TISS…) na pasta de plugins e reabra o programa."/>
                        <TextBlock x:Name="PluginPath" Style="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="16,0,0,0" Click="OpenPlugins_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14"/>
                            <TextBlock Text="Abrir pasta" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
