<UserControl x:Class="FazTudo.Desktop.Views.TriadorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Background="Transparent"
             DragEnter="View_DragEnter" DragOver="View_DragEnter" DragLeave="View_DragLeave" Drop="View_Drop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,4,0,20">
            <StackPanel x:Name="HeaderActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Visibility="Collapsed">
                <Button x:Name="AnotherButton" Style="{StaticResource SecondaryButton}" Click="ChooseFile_Click" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="14"/>
                        <TextBlock Text="Analisar outro arquivo" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ExportButton" Style="{StaticResource PrimaryButton}" Click="Export_Click"
                        ToolTip="Planilha com cada linha a corrigir, o problema e o que fazer">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14"/>
                        <TextBlock Text="Exportar para Excel" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Triador BPA" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Lead}" Margin="0,6,0,0"
                           Text="Descubra antes do envio quais linhas da remessa o SIA vai rejeitar — e quanto isso custa."/>
            </StackPanel>
        </DockPanel>

        <!-- ============ Estado vazio / arrastar e soltar ============ -->
        <Grid x:Name="EmptyState" Grid.Row="1">
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Rectangle x:Name="DropOutline" Margin="16" RadiusX="12" RadiusY="12" Stroke="{StaticResource LineStrongBrush}"
                               StrokeThickness="2" StrokeDashArray="5 4" Fill="Transparent"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                        <Border Width="72" Height="72" CornerRadius="20" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                            <TextBlock x:Name="DropIcon" Text="&#xE898;" Style="{StaticResource Icon}" FontSize="30"
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="DropTitle" Text="Arraste a remessa do BPA-Mag para cá" Style="{StaticResource H2}"
                                   TextAlignment="Center" Margin="0,22,0,0"/>
                        <TextBlock Style="{StaticResource Lead}" TextAlignment="Center" Margin="0,8,0,22"
                                   Text="Arquivos PA*.* ou .txt exportados pelo BPA-Mag. A análise roda neste computador: nada é enviado para fora."/>
                        <Button x:Name="ChooseButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="ChooseFile_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="14"/>
                                <TextBlock x:Name="ChooseButtonText" Text="Escolher arquivo" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="16,12" Margin="0,30,0,0">
                            <StackPanel>
                                <TextBlock Text="O QUE É VERIFICADO" Style="{StaticResource Overline}"/>
                                <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"
                                           Text="CNS do paciente e do profissional · CBO × procedimento · sexo · faixa etária · instrumento (BPA-C/BPA-I) · CID obrigatório · raça/cor e etnia · competência"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Resultado ============ -->
        <Grid x:Name="ResultState" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Arquivo -->
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Width="36" Height="36" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="FileName" Style="{StaticResource H3}"/>
                        <TextBlock x:Name="FileMeta" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Indicadores -->
            <UniformGrid Grid.Row="1" Rows="1" Margin="-8,0,-8,16">
                <Border Style="{StaticResource Card}" Margin="8,0" Padding="18,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D5;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="LINHAS AVALIADAS" Style="{StaticResource Overline}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="KpiTotal" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock x:Name="KpiTotalSub" Style="{StaticResource Caption}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0" Padding="18,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="SEM CRÍTICA" Style="{StaticResource Overline}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="KpiValid" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="KpiValidSub" Style="{StaticResource Caption}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0" Padding="18,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="CRÍTICAS" Style="{StaticResource Overline}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="KpiFindings" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="KpiFindingsSub" Style="{StaticResource Caption}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0" Padding="18,16" Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBorderBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C7;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource DangerBrush}"/>
                            <TextBlock Text="GLOSA ESTIMADA" Style="{StaticResource Overline}" Foreground="{StaticResource DangerBrush}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="KpiGlosa" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="KpiGlosaSub" Style="{StaticResource Caption}" FontSize="12" Foreground="#991B1B"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Avisos -->
            <ItemsControl x:Name="WarningsList" Grid.Row="2" Margin="0,0,0,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="14,10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top" Margin="0,3,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Body}" Foreground="#78350F"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Alternador -->
            <Border Grid.Row="3" Background="#E9EDF3" CornerRadius="9" Padding="3" HorizontalAlignment="Left" Margin="0,4,0,14">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ShowGroups" Style="{StaticResource Segment}" GroupName="TriadorView" IsChecked="True" Checked="ViewToggle_Checked">
                        <TextBlock x:Name="ShowGroupsText" Text="Causas raiz"/>
                    </RadioButton>
                    <RadioButton x:Name="ShowLines" Style="{StaticResource Segment}" GroupName="TriadorView" Checked="ViewToggle_Checked">
                        <TextBlock x:Name="ShowLinesText" Text="Linhas com crítica"/>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Causas raiz -->
            <ScrollViewer x:Name="GroupsPanel" Grid.Row="4" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="GroupsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,4,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Pill}" Background="{StaticResource DangerSoftBrush}">
                                                <TextBlock Text="{Binding Group.ErrorCode}" Style="{StaticResource Mono}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Detail}" FontWeight="SemiBold" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Group.RootCauseTitle}" Style="{StaticResource H3}" FontSize="15" Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding Procedure}" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                                            <TextBlock Text="{Binding Group.RecommendedAction}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="6,0,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Content="Ver passo a passo completo →" Style="{StaticResource LinkButton}" Margin="0,10,0,0" HorizontalAlignment="Left"
                                                Tag="{Binding Group.LinkedKnowledgeErrorId}" Click="KnowledgeLink_Click"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Group.TotalFinancialImpact, StringFormat=C}" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                                                   FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Right"/>
                                        <TextBlock Style="{StaticResource Caption}" FontSize="12" HorizontalAlignment="Right">
                                            <Run Text="{Binding Group.OccurrencesCount, Mode=OneWay}"/><Run Text=" linha(s) · "/><Run Text="{Binding Group.TotalProceduresAffected, Mode=OneWay}"/><Run Text=" proced."/>
                                        </TextBlock>
                                        <Grid Width="180" Height="6" Margin="0,12,0,0" HorizontalAlignment="Right">
                                            <Border Background="{StaticResource HoverBrush}" CornerRadius="3"/>
                                            <Border Background="{StaticResource DangerBrush}" CornerRadius="3" HorizontalAlignment="Left" Width="{Binding BarWidth}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding ShareText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Linhas -->
            <Border x:Name="LinesPanel" Grid.Row="4" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
                <DataGrid x:Name="LinesGrid" MouseDoubleClick="LinesGrid_MouseDoubleClick" ToolTip="Duplo clique abre a solução na Base de Erros">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="LINHA" Binding="{Binding LineNumber}" Width="70" ElementStyle="{StaticResource CellMono}"/>
                        <DataGridTemplateColumn Header="CRÍTICA" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Pill}" Background="{StaticResource DangerSoftBrush}">
                                        <TextBlock Text="{Binding ErrorCode}" Style="{StaticResource Mono}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="INSTR." Binding="{Binding Instrument}" Width="70" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="PROCEDIMENTO" Binding="{Binding ProcedureCode}" Width="115" ElementStyle="{StaticResource CellMono}"/>
                        <DataGridTextColumn Header="CBO" Binding="{Binding Cbo}" Width="80" ElementStyle="{StaticResource CellMono}"/>
                        <DataGridTextColumn Header="REFERÊNCIA" Binding="{Binding PatientOrProfessionalRef}" Width="215" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTemplateColumn Header="O QUE ESTÁ ERRADO" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ErrorDescription}" Style="{StaticResource CellText}" ToolTip="{Binding ErrorDescription}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="VALOR" Binding="{Binding EstimatedLoss, StringFormat=C}" Width="100" ElementStyle="{StaticResource CellMoney}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Tudo certo -->
            <Border x:Name="AllClearPanel" Grid.Row="4" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource SuccessSoftBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="30" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Nenhuma crítica encontrada" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,18,0,6"/>
                    <TextBlock Text="Todas as linhas passaram nas verificações. Confira os avisos acima, se houver." Style="{StaticResource Lead}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
