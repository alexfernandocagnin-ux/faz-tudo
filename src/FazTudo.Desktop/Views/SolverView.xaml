<UserControl x:Class="FazTudo.Desktop.Views.SolverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Background="Transparent"
             DragEnter="View_DragEnter" DragOver="View_DragEnter" DragLeave="View_DragLeave" Drop="View_Drop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,4,0,20">
            <StackPanel x:Name="HeaderActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Visibility="Collapsed">
                <Button Style="{StaticResource SecondaryButton}" Click="ChooseFile_Click" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="14"/>
                        <TextBlock Text="Abrir outro relatório" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CopyButton" Style="{StaticResource PrimaryButton}" Click="Copy_Click"
                        ToolTip="Copia a resposta em texto para colar no e-mail ou no WhatsApp">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="14"/>
                        <TextBlock x:Name="CopyButtonText" Text="Copiar resposta" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Solucionador SIA" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Lead}" Margin="0,6,0,0"
                           Text="Envie o relatório de erros da consistência do SIA e receba, pronto, o que cada estabelecimento precisa corrigir — com a mensagem para mandar."/>
            </StackPanel>
        </DockPanel>

        <!-- ============ Estado vazio ============ -->
        <Border x:Name="EmptyState" Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Rectangle x:Name="DropOutline" Margin="16" RadiusX="12" RadiusY="12" Stroke="{StaticResource LineStrongBrush}"
                           StrokeThickness="2" StrokeDashArray="5 4" Fill="Transparent"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
                    <Border Width="72" Height="72" CornerRadius="20" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xEA80;" Style="{StaticResource Icon}" FontSize="30" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="DropTitle" Text="Arraste os relatórios do SIA para cá" Style="{StaticResource H2}" TextAlignment="Center" Margin="0,22,0,0"/>
                    <TextBlock Style="{StaticResource Lead}" TextAlignment="Center" Margin="0,8,0,22"
                               Text="O R0350.OUT (erros da consistência) e, se houver erro de APAC, também o R0330T.OUT (espelho das APACs). Ficam na pasta do processamento do SIA, ex.: C:\Datasus\SIA\SIA_2026_10_Processamento."/>
                    <Button x:Name="ChooseButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="ChooseFile_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="14"/>
                            <TextBlock x:Name="ChooseButtonText" Text="Escolher relatório" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="16,12" Margin="0,30,0,0">
                        <StackPanel>
                            <TextBlock Text="O QUE VOCÊ RECEBE" Style="{StaticResource Overline}"/>
                            <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"
                                       Text="Cada ocorrência explicada em português, quais fichas e APACs foram afetadas, o que as regras do SIGTAP dizem sobre elas e o passo a passo para corrigir."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Resposta ============ -->
        <ScrollViewer x:Name="ResultState" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="0,0,6,0">
                <!-- Resumo -->
                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}" Width="44" Height="44">
                            <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock x:Name="FileMeta" Style="{StaticResource Caption}" FontSize="12"/>
                            <TextBlock x:Name="Headline" Style="{StaticResource H2}" FontSize="18" Margin="0,4,0,0"/>
                            <WrapPanel x:Name="GroupPills" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ItemsControl x:Name="NotesList" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="14,10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top" Margin="0,3,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Body}" Foreground="#78350F"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- O que fazer, por responsável -->
                <TextBlock Text="O que fazer" Style="{StaticResource H2}" Margin="0,6,0,10"/>
                <ItemsControl x:Name="OwnersList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource SecondaryButton}"
                                                Tag="{Binding Message}" Click="CopyMessage_Click"
                                                ToolTip="Copia a mensagem pronta para mandar a este responsável">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE724;" Style="{StaticResource Icon}" FontSize="14"/>
                                                <TextBlock Text="Copiar mensagem" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Border Width="52" Height="52" CornerRadius="12" Background="{StaticResource AccentBrush}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding AreaKey}" Foreground="White" FontWeight="Bold" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="14,0,14,0">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Overline}" Foreground="{StaticResource AccentHoverBrush}"/>
                                            <TextBlock Text="{Binding Where}" Style="{StaticResource H3}" FontSize="16" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Who}" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,14,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource Pill}" Background="{StaticResource DangerSoftBrush}" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Code}" Style="{StaticResource Mono}" FontSize="11.5" FontWeight="Bold"
                                                                   Foreground="{StaticResource DangerBrush}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Body}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Detalhes de cada erro" Style="{StaticResource H2}" Margin="0,18,0,4"/>
                <TextBlock Text="Para quem quer entender o porquê. Para corrigir, a lista acima já basta." Style="{StaticResource Caption}"
                           FontSize="12.5" Margin="0,0,0,12"/>

                <!-- Problemas -->
                <ItemsControl x:Name="ProblemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding QuantityDisplay}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{Binding Group, Converter={StaticResource SiaGroupBrush}}" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Pill}" Background="{Binding Group, Converter={StaticResource SiaGroupBrush}, ConverterParameter=soft}">
                                                <TextBlock Text="{Binding Code}" Style="{StaticResource Mono}" FontSize="12" FontWeight="Bold"
                                                           Foreground="{Binding Group, Converter={StaticResource SiaGroupBrush}}"/>
                                            </Border>
                                            <TextBlock Text="{Binding GroupMeaning}" Style="{StaticResource Caption}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="18" Margin="0,12,0,0"/>
                                    <TextBlock Text="{Binding Description, StringFormat=No SIA: {0}}" Style="{StaticResource Mono}" FontSize="11.5"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>

                                    <!-- Onde resolver -->
                                    <Border Margin="0,16,0,0" CornerRadius="10" Background="{StaticResource AccentSoftBrush}"
                                            BorderBrush="{StaticResource AccentSoftBorderBrush}" BorderThickness="1" Padding="16,14"
                                            DataContext="{Binding MainArea}"
                                            Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="52" Height="52" CornerRadius="12" Background="{StaticResource AccentBrush}" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Key}" Foreground="White" FontWeight="Bold" FontSize="13"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                <TextBlock Text="ONDE RESOLVER" Style="{StaticResource Overline}" Foreground="{StaticResource AccentHoverBrush}"/>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource H3}" FontSize="15" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Who}" Style="{StaticResource Body}" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding Action}" Style="{StaticResource Body}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                <ItemsControl ItemsSource="{Binding Details}" Margin="0,8,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="20"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                                                           VerticalAlignment="Top" Margin="0,4,0,0"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding AlternativeAreas}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,8,0,0" CornerRadius="10" Background="{StaticResource SurfaceAltBrush}"
                                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16,10">
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource Body}">
                                                            <Run Text="Também pode ser " Foreground="{StaticResource TextSecondaryBrush}"/><Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=": " /><Run Text="{Binding Who, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Action}" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="O QUE EU VI NO SEU RELATÓRIO" Style="{StaticResource Overline}" Margin="0,18,0,8"/>
                                    <ItemsControl ItemsSource="{Binding Findings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE7B3;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Top" Margin="0,4,0,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Body}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="COMO RESOLVER" Style="{StaticResource Overline}" Margin="0,12,0,10"/>
                                    <ItemsControl ItemsSource="{Binding Steps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="38"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource AccentBrush}" VerticalAlignment="Top" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding StepNumber}" Foreground="White" FontWeight="Bold" FontSize="12"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding ActionTitle}" Style="{StaticResource H3}"/>
                                                        <TextBlock Text="{Binding TargetSystem}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding DetailedInstruction}" Style="{StaticResource Body}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                                                        <TextBlock Text="{Binding VerificationTip, StringFormat=✓ {0}}" Style="{StaticResource Body}" Foreground="#115E59" Margin="0,5,0,0"
                                                                   Visibility="{Binding VerificationTip, Converter={StaticResource NullToCollapsed}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="Ver na Base de Erros →" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,2,0,0"
                                            Tag="{Binding Knowledge.Id}" Click="KnowledgeLink_Click"
                                            Visibility="{Binding Knowledge, Converter={StaticResource NullToCollapsed}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
